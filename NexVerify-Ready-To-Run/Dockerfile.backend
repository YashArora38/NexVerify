# NexVerify Backend - Production Dockerfile for Railway / Linux
FROM python:3.12-slim

# Prevent Python from buffering stdout/stderr and writing .pyc files
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NEXVERIFY_DATA_DIR=/app/data \
    DATABASE_URL=sqlite:////app/data/nexverify.db \
    NEXVERIFY_ENV=production \
    NEXVERIFY_ALLOW_ACTIVE_BROWSER=false \
    PORT=8000

# Install minimal OS dependencies for network & cryptography
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy backend requirements and install dependencies
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

# Copy backend application source code and seed data structure
COPY backend/app /app/backend/app
COPY data /app/data

# Ensure persistent directories exist
RUN mkdir -p /app/data/evidence /app/data/reports /app/data/feeds

WORKDIR /app/backend

# Expose backend port
EXPOSE 8000

# Health check using FastAPI /api/health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/api/health || exit 1

# Start Uvicorn production server
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --proxy-headers --forwarded-allow-ips='*'"]
