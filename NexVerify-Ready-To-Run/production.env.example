# NexVerify Production Environment Variables Template
# Copy this file to .env in production deployment environments.

# Application Environment Mode ('production' or 'development')
# In 'production', /docs and /redoc are disabled, and active browser sandboxes are off by default.
NEXVERIFY_ENV=production

# Network & Server Port (defaults to 8000 for backend)
PORT=8000

# Persistent Data Storage Directory
# When mounting a persistent volume in Railway, map to /app/data
NEXVERIFY_DATA_DIR=/app/data

# Database Connection URL
# SQLite default on persistent volume:
DATABASE_URL=sqlite:////app/data/nexverify.db
# PostgreSQL alternative (if Railway Postgres plugin is added):
# DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# CORS Origins (Comma-separated list of allowed origins)
# Include your Railway frontend public domain:
CORS_ORIGINS=https://your-frontend-app.up.railway.app,http://localhost:3000

# Gemini AI Grounding & Translation (Optional - fallback template runs if empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_RPM=12
GEMINI_MAX_WAIT_SECONDS=12
CHECK_DEADLINE_SECONDS=55
AI_SUMMARY=false

# Threat Intelligence APIs (Optional - passive checks gracefully degrade if empty)
SAFE_BROWSING_KEY=
VT_KEY=
URLSCAN_KEY=
OTX_KEY=

# Blockchain Anchoring (Ethereum Sepolia - Chain ID 11155111)
# Note: Salted SHA-256 is a cryptographic commitment scheme, NOT a zero-knowledge proof.
NEXVERIFY_ANCHOR_PREPARATION=true
NEXVERIFY_ANCHOR_CHAIN_ID=11155111
NEXVERIFY_ANCHOR_CONTRACT=0x5FbDB2315678afecb367f032d93F642f64180aa3
NEXVERIFY_ANCHOR_RPC_URL=https://rpc.sepolia.org
NEXVERIFY_ANCHOR_MIN_CONFIRMATIONS=1

# Security Boundaries
NEXVERIFY_ALLOW_ACTIVE_BROWSER=false
